[
  {
    "id": "all-bool-and-days",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "monitored",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "fact": "added_at",
          "operator": "MORE_THAN_DAYS_AGO",
          "value": "90"
        },
        {
          "fact": "has_file",
          "operator": "IS_FALSE",
          "value": ""
        }
      ],
      "actions": {
        "NOTIFY": "Removed an old title",
        "DELETE_FILES": true,
        "UNMONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.monitored\n\tdays_since(input.facts.added_at) > 90\n\tnot input.facts.has_file\n}\n\nunmonitor if rule_applies\n\ndelete_files if rule_applies\n\nnotify := \"Removed an old title\" if rule_applies\n"
  },
  {
    "id": "any-string-lists",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ANY",
      "conditions": [
        {
          "fact": "tags",
          "operator": "CONTAINS",
          "value": "sample-keep"
        },
        {
          "fact": "tags",
          "operator": "NOT_CONTAINS",
          "value": "sample-archive"
        },
        {
          "fact": "lists_names",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "fact": "requested_by_usernames",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        }
      ],
      "actions": {
        "REMOVE_TAGS": [
          "sample-fresh"
        ],
        "ADD_TAGS": [
          "sample-review",
          "sample-stale"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\t\"sample-keep\" in input.facts.tags\n}\n\nrule_applies if {\n\tnot \"sample-archive\" in input.facts.tags\n}\n\nrule_applies if {\n\tcount(input.facts.lists_names) == 0\n}\n\nrule_applies if {\n\tcount(input.facts.requested_by_usernames) > 0\n}\n\nadd_tags := [\"sample-review\", \"sample-stale\"] if rule_applies\n\nremove_tags := [\"sample-fresh\"] if rule_applies\n"
  },
  {
    "id": "all-number-comparisons",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "file_count",
          "operator": "EQUALS",
          "value": "0"
        },
        {
          "fact": "episode_count",
          "operator": "NOT_EQUALS",
          "value": "3"
        },
        {
          "fact": "total_file_size_bytes",
          "operator": "GREATER_THAN",
          "value": "1073741824"
        },
        {
          "fact": "storage_available_percent",
          "operator": "GREATER_OR_EQUAL",
          "value": "1.5"
        },
        {
          "fact": "lists_best_rank",
          "operator": "LESS_THAN",
          "value": "-2"
        },
        {
          "fact": "lists_days_on_list",
          "operator": "LESS_OR_EQUAL",
          "value": "10"
        },
        {
          "fact": "active_retention_claims",
          "operator": "HAS_NO_VALUE",
          "value": ""
        },
        {
          "fact": "storage_total_bytes",
          "operator": "HAS_VALUE",
          "value": ""
        }
      ],
      "actions": {
        "FETCH_SUBTITLES": true,
        "SEARCH": true,
        "SET_QUALITY_PROFILE": "Sample Profile"
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.file_count == 0\n\tinput.facts.episode_count != 3\n\tinput.facts.total_file_size_bytes > 1073741824\n\tinput.facts.storage_available_percent >= 1.5\n\tinput.facts.lists_best_rank < -2\n\tinput.facts.lists_days_on_list <= 10\n\tnot input.facts.active_retention_claims\n\tinput.facts.storage_total_bytes\n}\n\nset_quality_profile := \"Sample Profile\" if rule_applies\n\nsearch if rule_applies\n\nfetch_subtitles if rule_applies\n"
  },
  {
    "id": "all-strings-and-timestamps",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "request_origin",
          "operator": "EQUALS",
          "value": "list"
        },
        {
          "fact": "added_by_username",
          "operator": "NOT_EQUALS",
          "value": "sample-user"
        },
        {
          "fact": "request_list_name",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "fact": "quality_profile_id",
          "operator": "HAS_NO_VALUE",
          "value": ""
        },
        {
          "fact": "last_watched_at",
          "operator": "LESS_THAN_DAYS_AGO",
          "value": "30"
        },
        {
          "fact": "lists_left_at",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "fact": "first_imported_at",
          "operator": "HAS_NO_VALUE",
          "value": ""
        }
      ],
      "actions": {
        "SEARCH": true,
        "MONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.request_origin == \"list\"\n\tinput.facts.added_by_username != \"sample-user\"\n\tinput.facts.request_list_name\n\tnot input.facts.quality_profile_id\n\tdays_since(input.facts.last_watched_at) < 30\n\tinput.facts.lists_left_at\n\tnot input.facts.first_imported_at\n}\n\nmonitor if rule_applies\n\nsearch if rule_applies\n"
  },
  {
    "id": "title-move-to-library",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "lists_left_all",
          "operator": "IS_TRUE",
          "value": ""
        }
      ],
      "actions": {
        "MOVE_TO_LIBRARY": "Sample Library"
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.lists_left_all\n}\n\nmove_to_library := \"Sample Library\" if rule_applies\n"
  },
  {
    "id": "title-move-to-root",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ANY",
      "conditions": [
        {
          "fact": "watched_by_anyone",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "fact": "storage_root_id",
          "operator": "EQUALS",
          "value": "sample-root"
        }
      ],
      "actions": {
        "MOVE_TO_ROOT": "/data/sample root",
        "UNMONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.watched_by_anyone\n}\n\nrule_applies if {\n\tinput.facts.storage_root_id == \"sample-root\"\n}\n\nmove_to_root := \"/data/sample root\" if rule_applies\n\nunmonitor if rule_applies\n"
  },
  {
    "id": "title-delete-title",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "request_lease_expires_at",
          "operator": "MORE_THAN_DAYS_AGO",
          "value": "0"
        }
      ],
      "actions": {
        "DELETE_TITLE": true,
        "UNMONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tdays_since(input.facts.request_lease_expires_at) > 0\n}\n\nunmonitor if rule_applies\n\ndelete_title if rule_applies\n"
  },
  {
    "id": "escaping",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "added_by_username",
          "operator": "EQUALS",
          "value": "sample \"quoted\" \\ user"
        },
        {
          "fact": "tags",
          "operator": "CONTAINS",
          "value": "Ünïcødé 標籤 😀"
        }
      ],
      "actions": {
        "NOTIFY": "Say \"hi\" to C:\\sample\\path",
        "ADD_TAGS": [
          "tag \"one\"",
          "tag\\two"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.added_by_username == \"sample \\\"quoted\\\" \\\\ user\"\n\t\"Ünïcødé 標籤 😀\" in input.facts.tags\n}\n\nadd_tags := [\"tag \\\"one\\\"\", \"tag\\\\two\"] if rule_applies\n\nnotify := \"Say \\\"hi\\\" to C:\\\\sample\\\\path\" if rule_applies\n"
  },
  {
    "id": "episode-scope",
    "scope": "EPISODE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "monitored",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "fact": "episode_position_by_air_date",
          "operator": "LESS_OR_EQUAL",
          "value": "2"
        }
      ],
      "actions": {
        "DELETE_FILES": true,
        "UNMONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.monitored\n\tinput.facts.episode_position_by_air_date <= 2\n}\n\nunmonitor if rule_applies\n\ndelete_files if rule_applies\n"
  },
  {
    "id": "every-title-action-in-order",
    "scope": "TITLE",
    "model": {
      "version": 1,
      "join": "ALL",
      "conditions": [
        {
          "fact": "requested",
          "operator": "IS_FALSE",
          "value": ""
        }
      ],
      "actions": {
        "NOTIFY": "Sample notice",
        "DELETE_FILES": true,
        "UNMONITOR": true,
        "FETCH_SUBTITLES": true,
        "SEARCH": true,
        "SET_QUALITY_PROFILE": "Sample Profile",
        "REMOVE_TAGS": [
          "sample-old"
        ],
        "ADD_TAGS": [
          "sample-new"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tnot input.facts.requested\n}\n\nadd_tags := [\"sample-new\"] if rule_applies\n\nremove_tags := [\"sample-old\"] if rule_applies\n\nset_quality_profile := \"Sample Profile\" if rule_applies\n\nsearch if rule_applies\n\nfetch_subtitles if rule_applies\n\nunmonitor if rule_applies\n\ndelete_files if rule_applies\n\nnotify := \"Sample notice\" if rule_applies\n"
  }
]
