[
  {
    "id": "all-bool-and-days",
    "scope": "TITLE",
    "model": {
      "version": 2,
      "family": "maintenance",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.facts.monitored",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.facts.added_at",
          "operator": "MORE_THAN_DAYS_AGO",
          "value": "90"
        },
        {
          "field": "input.facts.has_file",
          "operator": "IS_FALSE",
          "value": ""
        }
      ],
      "outputs": {
        "NOTIFY": "Removed an old title",
        "DELETE_FILES": true,
        "UNMONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.monitored == true\n\tdays_since(input.facts.added_at) > 90\n\tinput.facts.has_file == false\n}\n\nunmonitor if rule_applies\n\ndelete_files if rule_applies\n\nnotify := \"Removed an old title\" if rule_applies\n",
    "cases": [
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "monitored": true,
            "added_at": "2025-06-05T00:00:00Z",
            "has_file": false
          }
        },
        "expected": true
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "monitored": true,
            "added_at": "2025-06-05T00:00:00Z"
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "monitored": false,
            "added_at": "2025-06-05T00:00:00Z",
            "has_file": false
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "monitored": true,
            "added_at": "2026-01-21T00:00:00Z",
            "has_file": false
          }
        },
        "expected": false
      }
    ]
  },
  {
    "id": "any-string-lists",
    "scope": "TITLE",
    "model": {
      "version": 2,
      "family": "maintenance",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.facts.tags",
          "operator": "CONTAINS",
          "value": "sample-keep"
        },
        {
          "field": "input.facts.tags",
          "operator": "NOT_CONTAINS",
          "value": "sample-archive"
        },
        {
          "field": "input.facts.lists_names",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "field": "input.facts.requested_by_usernames",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        }
      ],
      "outputs": {
        "REMOVE_TAGS": [
          "sample-fresh"
        ],
        "ADD_TAGS": [
          "sample-review",
          "sample-stale"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\t\"sample-keep\" in input.facts.tags\n}\n\nrule_applies if {\n\tis_array(input.facts.tags)\n\tnot \"sample-archive\" in input.facts.tags\n}\n\nrule_applies if {\n\tcount(input.facts.lists_names) == 0\n}\n\nrule_applies if {\n\tcount(input.facts.requested_by_usernames) > 0\n}\n\nadd_tags := [\"sample-review\", \"sample-stale\"] if rule_applies\n\nremove_tags := [\"sample-fresh\"] if rule_applies\n",
    "cases": [
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "tags": [
              "sample-archive"
            ],
            "lists_names": [
              "Sample List"
            ],
            "requested_by_usernames": []
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "tags": [
              "sample-other"
            ],
            "lists_names": [
              "Sample List"
            ],
            "requested_by_usernames": []
          }
        },
        "expected": true
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "tags": [
              "sample-archive",
              "sample-keep"
            ],
            "lists_names": [
              "Sample List"
            ],
            "requested_by_usernames": []
          }
        },
        "expected": true
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "lists_names": [
              "Sample List"
            ],
            "requested_by_usernames": []
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "tags": [
              "sample-archive"
            ],
            "lists_names": [],
            "requested_by_usernames": []
          }
        },
        "expected": true
      }
    ]
  },
  {
    "id": "all-number-comparisons",
    "scope": "TITLE",
    "model": {
      "version": 2,
      "family": "maintenance",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.facts.file_count",
          "operator": "EQUALS",
          "value": "0"
        },
        {
          "field": "input.facts.episode_count",
          "operator": "NOT_EQUALS",
          "value": "3"
        },
        {
          "field": "input.facts.total_file_size_bytes",
          "operator": "GREATER_THAN",
          "value": "1073741824"
        },
        {
          "field": "input.facts.storage_available_percent",
          "operator": "GREATER_OR_EQUAL",
          "value": "1.5"
        },
        {
          "field": "input.facts.lists_best_rank",
          "operator": "LESS_THAN",
          "value": "-2"
        },
        {
          "field": "input.facts.lists_days_on_list",
          "operator": "LESS_OR_EQUAL",
          "value": "10"
        },
        {
          "field": "input.facts.active_retention_claims",
          "operator": "HAS_NO_VALUE",
          "value": ""
        },
        {
          "field": "input.facts.storage_total_bytes",
          "operator": "HAS_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "FETCH_SUBTITLES": true,
        "SEARCH": true,
        "SET_QUALITY_PROFILE": "Sample Profile"
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.file_count == 0\n\tis_number(input.facts.episode_count)\n\tinput.facts.episode_count != 3\n\tis_number(input.facts.total_file_size_bytes)\n\tinput.facts.total_file_size_bytes > 1073741824\n\tis_number(input.facts.storage_available_percent)\n\tinput.facts.storage_available_percent >= 1.5\n\tis_number(input.facts.lists_best_rank)\n\tinput.facts.lists_best_rank < -2\n\tis_number(input.facts.lists_days_on_list)\n\tinput.facts.lists_days_on_list <= 10\n\tnot input.facts.active_retention_claims != null\n\tinput.facts.storage_total_bytes != null\n}\n\nset_quality_profile := \"Sample Profile\" if rule_applies\n\nsearch if rule_applies\n\nfetch_subtitles if rule_applies\n",
    "cases": [
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "file_count": 0,
            "episode_count": 4,
            "total_file_size_bytes": 2147483648,
            "storage_available_percent": 1.5,
            "lists_best_rank": -3,
            "lists_days_on_list": 10,
            "storage_total_bytes": 1000
          }
        },
        "expected": true
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "file_count": 0,
            "total_file_size_bytes": 2147483648,
            "storage_available_percent": 1.5,
            "lists_best_rank": -3,
            "lists_days_on_list": 10,
            "storage_total_bytes": 1000
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "file_count": 0,
            "episode_count": 3,
            "total_file_size_bytes": 2147483648,
            "storage_available_percent": 1.5,
            "lists_best_rank": -3,
            "lists_days_on_list": 10,
            "storage_total_bytes": 1000
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "file_count": 0,
            "episode_count": 4,
            "total_file_size_bytes": 2147483648,
            "storage_available_percent": 1.5,
            "lists_best_rank": -3,
            "lists_days_on_list": 10,
            "storage_total_bytes": 1000,
            "active_retention_claims": 2
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "file_count": 0,
            "episode_count": 4,
            "total_file_size_bytes": 2147483648,
            "storage_available_percent": 1.5,
            "lists_best_rank": -3,
            "lists_days_on_list": 10
          }
        },
        "expected": false
      }
    ]
  },
  {
    "id": "all-strings-and-timestamps",
