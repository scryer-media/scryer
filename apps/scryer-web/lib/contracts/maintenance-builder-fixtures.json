          "facts": {
            "request_origin": "list",
            "added_by_username": "sample-other-user",
            "request_list_name": "Sample List",
            "last_watched_at": "2026-02-10T00:00:00Z",
            "lists_left_at": "2026-01-01T00:00:00Z"
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "request_origin": "list",
            "added_by_username": "sample-other-user",
            "request_list_name": "Sample List",
            "last_watched_at": "2025-12-01T00:00:00Z",
            "lists_left_at": "2026-01-01T00:00:00Z"
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "request_origin": "list",
            "added_by_username": "sample-other-user",
            "request_list_name": "Sample List",
            "lists_left_at": "2026-01-01T00:00:00Z"
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "request_origin": "list",
            "request_list_name": "Sample List",
            "last_watched_at": "2026-01-21T00:00:00Z",
            "lists_left_at": "2026-01-01T00:00:00Z"
          }
        },
        "expected": false
      },
      {
        "input": {
          "evaluation_time": "2026-01-31T00:00:00Z",
          "facts": {
            "request_origin": "list",
            "added_by_username": "sample-other-user",
            "request_list_name": "Sample List",
            "last_watched_at": "2026-01-21T00:00:00Z",
            "lists_left_at": "2026-01-01T00:00:00Z",
            "quality_profile_id": "sample-profile"
          }
        },
        "expected": false
      }
    ]
  },
