          "operator": "LESS_THAN_DAYS_AGO",
          "value": "30"
        },
        {
          "field": "input.facts.lists_left_at",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.facts.first_imported_at",
          "operator": "HAS_NO_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "SEARCH": true,
        "MONITOR": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.request_origin == \"list\"\n\tis_string(input.facts.added_by_username)\n\tinput.facts.added_by_username != \"sample-user\"\n\tinput.facts.request_list_name != null\n\tnot input.facts.quality_profile_id != null\n\tdays_since(input.facts.last_watched_at) >= 0\n\tdays_since(input.facts.last_watched_at) < 30\n\tinput.facts.lists_left_at != null\n\tnot input.facts.first_imported_at != null\n}\n\nmonitor if rule_applies\n\nsearch if rule_applies\n",
    "cases": [
      {
