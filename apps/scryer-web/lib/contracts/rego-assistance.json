{
  "helpers": [
    {
      "name": "scryer.block_score",
      "args": [],
      "returns": "number",
      "descKey": "settings.regoHelper.blockScore"
    },
    {
      "name": "scryer.size_gib",
      "args": ["bytes"],
      "returns": "number",
      "descKey": "settings.regoHelper.sizeGib"
    },
    {
      "name": "scryer.lang_matches",
      "args": ["code", "pattern"],
      "returns": "bool",
      "descKey": "settings.regoHelper.langMatches"
    },
    {
      "name": "scryer.normalize_source",
      "args": ["source"],
      "returns": "string",
      "descKey": "settings.regoHelper.normalizeSource"
    },
    {
      "name": "scryer.normalize_codec",
      "args": ["codec"],
      "returns": "string",
      "descKey": "settings.regoHelper.normalizeCodec"
    },
    {
      "name": "lower",
      "args": ["value"],
      "returns": "string",
      "descKey": "settings.regoHelper.lower"
    },
    {
      "name": "upper",
      "args": ["value"],
      "returns": "string",
      "descKey": "settings.regoHelper.upper"
    },
    {
      "name": "count",
      "args": ["value"],
      "returns": "number",
      "descKey": "settings.regoHelper.count"
    },
    {
      "name": "object.get",
      "args": ["object", "key", "default"],
      "returns": "any",
      "descKey": "settings.regoHelper.objectGet"
