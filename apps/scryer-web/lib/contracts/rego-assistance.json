  ],
  "snippets": [
    {
      "family": "release",
      "label": "score-entry",
      "descKey": "settings.regoSnippet.scoreEntry",
      "source": "score_entry[\"${1:bonus}\"] := ${2:100} if {\n    input.release.quality == \"${3:1080p}\"\n}"
    },
    {
      "family": "release",
      "label": "tag-score",
      "descKey": "settings.regoSnippet.tagScore",
      "source": "score_entry[\"${1:tag_bonus}\"] := ${2:100} if {\n    \"${3:favorites}\" in input.context.tags\n}"
    },
    {
      "family": "release",
      "label": "nullable-field",
      "descKey": "settings.regoSnippet.nullableField",
      "source": "score_entry[\"${1:group_bonus}\"] := ${2:100} if {\n    input.release.release_group != null\n    lower(input.release.release_group) == \"${3:groupa}\"\n}"
    },
    {
      "family": "request",
      "label": "deny-request",
      "descKey": "settings.regoSnippet.denyRequest",
      "source": "deny if {\n    input.facts.is_adult\n}"
    },
    {
      "family": "request",
      "label": "manual-request",
      "descKey": "settings.regoSnippet.manualRequest",
      "source": "manual if {\n    input.facts.approved_last_30d >= ${1:5}\n}"
    },
    {
      "family": "request",
      "label": "shape-request",
      "descKey": "settings.regoSnippet.shapeRequest",
      "source": "set_lease_days := ${1:30} if {\n    input.facts.is_adult\n}"
    },
    {
      "family": "request",
      "label": "tag-request",
      "descKey": "settings.regoSnippet.tagRequest",
      "source": "add_tags := [\"${1:family}\"] if {\n    input.facts.certification_rank <= ${2:1}\n}"
    },
    {
      "family": "maintenance",
      "label": "unmonitor-tagged",
      "descKey": "settings.regoSnippet.unmonitorTagged",
      "source": "unmonitor if {\n    \"${1:retire}\" in input.facts.tags\n}"
    },
    {
      "family": "maintenance",
      "label": "tag-after-days",
      "descKey": "settings.regoSnippet.tagAfterDays",
      "source": "add_tags := [\"${1:needs-review}\"] if {\n    days_since(input.facts.added_at) > ${2:365}\n}"
    },
    {
      "family": "maintenance",
      "label": "set-profile",
      "descKey": "settings.regoSnippet.setProfile",
      "source": "set_quality_profile := \"${1:Profile name}\" if {\n    input.facts.total_file_size_bytes > ${2:40000000000}\n}"
    }
  ]
}
