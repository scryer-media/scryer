          "field": "input.library.name",
          "operator": "NOT_EQUALS",
          "value": "Ünïcødé 標籤 😀"
        },
        {
          "field": "input.library.is_default",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.now.hour_utc",
