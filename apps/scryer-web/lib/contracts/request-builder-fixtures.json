  {
    "id": "shape-only-nullable-lists",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.request.required_audio_languages",
          "operator": "CONTAINS",
          "value": "eng"
        },
        {
          "field": "input.request.preferred_audio_languages",
          "operator": "NOT_CONTAINS",
          "value": "jpn"
        },
        {
          "field": "input.request.required_audio_languages",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "field": "input.request.preferred_audio_languages",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        },
        {
          "field": "input.request.required_audio_languages",
          "operator": "HAS_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "SET_REQUIRED_AUDIO_LANGUAGES": ["eng"],
        "SET_PREFERRED_AUDIO_LANGUAGES": ["jpn", "eng"],
        "ADD_TAGS": ["sample tag", "sample.second_tag-2"]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tis_array(input.request.required_audio_languages)\n\t\"eng\" in input.request.required_audio_languages\n}\n\nrule_applies if {\n\tis_array(input.request.preferred_audio_languages)\n\tnot \"jpn\" in input.request.preferred_audio_languages\n}\n\nrule_applies if {\n\tinput.request.required_audio_languages == []\n}\n\nrule_applies if {\n\tis_array(input.request.preferred_audio_languages)\n\tcount(input.request.preferred_audio_languages) > 0\n}\n\nrule_applies if {\n\tinput.request.required_audio_languages != null\n}\n\nset_required_audio_languages := [\"eng\"] if rule_applies\n\nset_preferred_audio_languages := [\"jpn\", \"eng\"] if rule_applies\n\nadd_tags := [\"sample tag\", \"sample.second_tag-2\"] if rule_applies\n",
    "cases": [
      {
        "input": {
          "request": {
            "required_audio_languages": null,
            "preferred_audio_languages": null
          }
        },
        "expected": false
      },
      {
        "input": {
          "request": {
            "required_audio_languages": null,
            "preferred_audio_languages": ["eng"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "request": {
            "required_audio_languages": null,
            "preferred_audio_languages": ["jpn"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "request": {
            "required_audio_languages": [],
            "preferred_audio_languages": null
          }
        },
        "expected": true
      },
      {
        "input": {},
        "expected": false
      }
    ]
  },
  {
    "id": "any-library-ids-and-tiers",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.facts.exists_in_library_ids",
          "operator": "CONTAINS",
          "value": "sample-library"
        },
        {
          "field": "input.facts.exists_in_library_ids",
          "operator": "NOT_CONTAINS",
          "value": "sample-other"
        },
        {
          "field": "input.facts.exists_in_library_ids",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "field": "input.facts.quality_profile_tiers",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        }
      ],
      "outputs": {
        "MANUAL": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\t\"sample-library\" in input.facts.exists_in_library_ids\n}\n\nrule_applies if {\n\tis_array(input.facts.exists_in_library_ids)\n\tnot \"sample-other\" in input.facts.exists_in_library_ids\n}\n\nrule_applies if {\n\tcount(input.facts.exists_in_library_ids) == 0\n}\n\nrule_applies if {\n\tcount(input.facts.quality_profile_tiers) > 0\n}\n\nmanual if rule_applies\n",
    "cases": [
      {
        "input": {
          "facts": {
            "exists_in_library_ids": ["sample-other"]
          }
        },
        "expected": false
      },
      {
        "input": {
          "facts": {
            "exists_in_library_ids": ["sample-library", "sample-other"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "facts": {
            "exists_in_library_ids": []
          }
        },
        "expected": true
      },
      {
        "input": {},
        "expected": false
      },
      {
        "input": {
          "facts": {
            "exists_in_library_ids": ["sample-other"],
            "quality_profile_tiers": ["sample-tier"]
          }
        },
        "expected": true
      }
    ]
  },
