[
  {
    "id": "approve-all-facts",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.facts.certification_rank",
          "operator": "LESS_OR_EQUAL",
          "value": "2"
        },
        {
          "field": "input.facts.is_adult",
          "operator": "IS_FALSE",
          "value": ""
        },
        {
          "field": "input.facts.commonsense_recommended",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.facts.tmdb_vote_average",
          "operator": "GREATER_OR_EQUAL",
          "value": "6.5"
        },
        {
          "field": "input.facts.runtime_minutes",
          "operator": "LESS_THAN",
          "value": "240"
        },
        {
          "field": "input.facts.previous_request_count",
          "operator": "EQUALS",
          "value": "0"
        },
        {
          "field": "input.facts.age_rating",
          "operator": "NOT_EQUALS",
          "value": "18"
        },
        {
          "field": "input.facts.approved_last_30d",
          "operator": "GREATER_THAN",
          "value": "1"
        }
      ],
      "outputs": {
        "APPROVE": true,
        "REASONS": [
          "sample_family_friendly"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.certification_rank <= 2\n\tinput.facts.is_adult == false\n\tinput.facts.commonsense_recommended == true\n\tinput.facts.tmdb_vote_average >= 6.5\n\tinput.facts.runtime_minutes < 240\n\tinput.facts.previous_request_count == 0\n\tinput.facts.age_rating != 18\n\tinput.facts.approved_last_30d > 1\n}\n\napprove if rule_applies\n\nreasons contains \"sample_family_friendly\" if rule_applies\n"
  },
  {
    "id": "deny-any-choices",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.request.origin",
          "operator": "EQUALS",
          "value": "public_list"
        },
        {
          "field": "input.library.facet",
          "operator": "NOT_EQUALS",
          "value": "anime"
        },
        {
          "field": "input.now.weekday",
          "operator": "EQUALS",
          "value": "sunday"
        },
        {
          "field": "input.facts.genres",
          "operator": "CONTAINS",
          "value": "Sample Genre"
        },
        {
          "field": "input.facts.themes",
          "operator": "NOT_CONTAINS",
          "value": "sample-theme"
        },
        {
          "field": "input.facts.exists_in_library_ids",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        },
        {
          "field": "input.facts.canonical_tag_keys",
          "operator": "IS_EMPTY",
          "value": ""
        }
      ],
      "outputs": {
        "DENY": true,
        "REASONS": [
          "sample_list_request",
          "sample_weekend"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.request.origin == \"public_list\"\n}\n\nrule_applies if {\n\tinput.library.facet != \"anime\"\n}\n\nrule_applies if {\n\tinput.now.weekday == \"sunday\"\n}\n\nrule_applies if {\n\t\"Sample Genre\" in input.facts.genres\n}\n\nrule_applies if {\n\tnot \"sample-theme\" in input.facts.themes\n}\n\nrule_applies if {\n\tcount(input.facts.exists_in_library_ids) > 0\n}\n\nrule_applies if {\n\tcount(input.facts.canonical_tag_keys) == 0\n}\n\ndeny if rule_applies\n\nreasons contains \"sample_list_request\" if rule_applies\n\nreasons contains \"sample_weekend\" if rule_applies\n"
  },
  {
    "id": "manual-nullable-values",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.request.year",
          "operator": "GREATER_THAN",
          "value": "2020"
        },
        {
          "field": "input.request.year",
          "operator": "LESS_OR_EQUAL",
          "value": "2030"
        },
        {
          "field": "input.request.lease_days",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.request.monitor_selection_season_count",
          "operator": "HAS_NO_VALUE",
          "value": ""
        },
        {
          "field": "input.request.lease_days",
          "operator": "NOT_EQUALS",
          "value": "30"
        },
        {
          "field": "input.request.lease_days",
          "operator": "GREATER_OR_EQUAL",
          "value": "7"
        },
        {
          "field": "input.request.lease_days",
          "operator": "LESS_THAN",
          "value": "365"
        },
        {
          "field": "input.request.list.rank",
          "operator": "EQUALS",
          "value": "1"
        },
        {
          "field": "input.request.quality_profile_name",
          "operator": "EQUALS",
          "value": "Sample Profile"
        },
        {
          "field": "input.request.monitor_type",
          "operator": "NOT_EQUALS",
          "value": "NONE"
        },
        {
          "field": "input.request.external_ids.imdb",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.request.external_ids.tvdb",
          "operator": "HAS_NO_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "MANUAL": true
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tis_number(input.request.year)\n\tinput.request.year > 2020\n\tis_number(input.request.year)\n\tinput.request.year <= 2030\n\tinput.request.lease_days != null\n\tnot input.request.monitor_selection_season_count != null\n\tis_number(input.request.lease_days)\n\tinput.request.lease_days != 30\n\tis_number(input.request.lease_days)\n\tinput.request.lease_days >= 7\n\tis_number(input.request.lease_days)\n\tinput.request.lease_days < 365\n\tinput.request.list.rank == 1\n\tinput.request.quality_profile_name == \"Sample Profile\"\n\tis_string(input.request.monitor_type)\n\tinput.request.monitor_type != \"NONE\"\n\tinput.request.external_ids.imdb != null\n\tnot input.request.external_ids.tvdb != null\n}\n\nmanual if rule_applies\n"
  },
  {
    "id": "tags-only-nullable-lists",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.request.required_audio_languages",
          "operator": "CONTAINS",
          "value": "en"
        },
        {
          "field": "input.request.preferred_audio_languages",
          "operator": "NOT_CONTAINS",
          "value": "ja"
        },
        {
          "field": "input.request.required_audio_languages",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "field": "input.request.preferred_audio_languages",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        },
        {
          "field": "input.request.required_audio_languages",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.request.preferred_audio_languages",
          "operator": "HAS_NO_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "TAGS": [
          "sample tag",
          "sample.second_tag-2"
        ]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tis_array(input.request.required_audio_languages)\n\t\"en\" in input.request.required_audio_languages\n}\n\nrule_applies if {\n\tis_array(input.request.preferred_audio_languages)\n\tnot \"ja\" in input.request.preferred_audio_languages\n}\n\nrule_applies if {\n\tinput.request.required_audio_languages == []\n}\n\nrule_applies if {\n\tis_array(input.request.preferred_audio_languages)\n\tcount(input.request.preferred_audio_languages) > 0\n}\n\nrule_applies if {\n\tinput.request.required_audio_languages != null\n}\n\nrule_applies if {\n\tnot input.request.preferred_audio_languages != null\n}\n\ntags contains \"sample tag\" if rule_applies\n\ntags contains \"sample.second_tag-2\" if rule_applies\n"
  },
  {
