[
  {
    "id": "approve-all-facts",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.facts.certification_rank",
          "operator": "LESS_OR_EQUAL",
          "value": "2"
        },
        {
          "field": "input.facts.is_adult",
          "operator": "IS_FALSE",
          "value": ""
        },
        {
          "field": "input.facts.commonsense_recommended",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.facts.tmdb_vote_average",
          "operator": "GREATER_OR_EQUAL",
          "value": "6.5"
        },
        {
          "field": "input.facts.runtime_minutes",
          "operator": "LESS_THAN",
          "value": "240"
        },
        {
          "field": "input.facts.previous_request_count",
          "operator": "EQUALS",
          "value": "0"
        },
        {
          "field": "input.facts.age_rating",
          "operator": "NOT_EQUALS",
          "value": "18"
        },
        {
          "field": "input.facts.approved_last_30d",
          "operator": "GREATER_THAN",
          "value": "1"
        }
      ],
      "outputs": {
        "APPROVE": true,
        "SET_QUALITY_PROFILE": "Sample Profile",
        "SET_LEASE_DAYS": "30",
        "REASONS": ["sample_family_friendly"]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.facts.certification_rank <= 2\n\tinput.facts.is_adult == false\n\tinput.facts.commonsense_recommended == true\n\tinput.facts.tmdb_vote_average >= 6.5\n\tinput.facts.runtime_minutes < 240\n\tinput.facts.previous_request_count == 0\n\tinput.facts.age_rating != 18\n\tinput.facts.approved_last_30d > 1\n}\n\napprove if rule_applies\n\nset_quality_profile := \"Sample Profile\" if rule_applies\n\nset_lease_days := 30 if rule_applies\n\nreasons contains \"sample_family_friendly\" if rule_applies\n",
    "cases": [
      {
        "input": {
          "facts": {
            "certification_rank": 2,
            "is_adult": false,
            "commonsense_recommended": true,
            "tmdb_vote_average": 6.5,
            "runtime_minutes": 239,
            "previous_request_count": 0,
            "age_rating": 12,
            "approved_last_30d": 2
          }
        },
        "expected": true
      },
      {
        "input": {
          "facts": {
            "certification_rank": 2,
            "commonsense_recommended": true,
            "tmdb_vote_average": 6.5,
            "runtime_minutes": 239,
            "previous_request_count": 0,
            "age_rating": 12,
            "approved_last_30d": 2
          }
        },
        "expected": false
      },
      {
        "input": {
          "facts": {
            "certification_rank": 2,
            "is_adult": false,
            "commonsense_recommended": true,
            "tmdb_vote_average": 6.5,
            "runtime_minutes": 239,
            "previous_request_count": 0,
            "approved_last_30d": 2
          }
        },
        "expected": false
      },
      {
        "input": {
          "facts": {
            "certification_rank": 2,
            "is_adult": false,
            "commonsense_recommended": true,
            "tmdb_vote_average": 6.5,
            "runtime_minutes": 239,
            "previous_request_count": 0,
            "age_rating": 18,
            "approved_last_30d": 2
          }
        },
        "expected": false
      }
    ]
  },
  {
    "id": "deny-any-choices",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.request.origin",
          "operator": "EQUALS",
          "value": "public_list"
        },
        {
          "field": "input.library.facet",
          "operator": "NOT_EQUALS",
          "value": "anime"
        },
        {
          "field": "input.now.weekday",
          "operator": "EQUALS",
          "value": "sunday"
        },
        {
          "field": "input.facts.genres",
          "operator": "CONTAINS",
          "value": "Sample Genre"
        },
        {
          "field": "input.facts.themes",
          "operator": "NOT_CONTAINS",
          "value": "sample-theme"
        },
        {
          "field": "input.facts.exists_in_library_ids",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        },
        {
          "field": "input.facts.canonical_tag_keys",
          "operator": "IS_EMPTY",
          "value": ""
        }
      ],
      "outputs": {
        "DENY": true,
        "NOTIFY": "Sample list request denied",
        "REASONS": ["sample_list_request", "sample_weekend"]
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.request.origin == \"public_list\"\n}\n\nrule_applies if {\n\tinput.library.facet != \"anime\"\n}\n\nrule_applies if {\n\tinput.now.weekday == \"sunday\"\n}\n\nrule_applies if {\n\t\"Sample Genre\" in input.facts.genres\n}\n\nrule_applies if {\n\tnot \"sample-theme\" in input.facts.themes\n}\n\nrule_applies if {\n\tcount(input.facts.exists_in_library_ids) > 0\n}\n\nrule_applies if {\n\tnot count(input.facts.canonical_tag_keys) > 0\n}\n\ndeny if rule_applies\n\nnotify := \"Sample list request denied\" if rule_applies\n\nreasons contains \"sample_list_request\" if rule_applies\n\nreasons contains \"sample_weekend\" if rule_applies\n",
    "cases": [
      {
        "input": {
          "request": {
            "origin": "manual"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "genres": ["Sample Other Genre"],
            "themes": ["sample-theme"],
            "exists_in_library_ids": [],
            "canonical_tag_keys": ["sample-key"]
          }
        },
        "expected": false
      },
      {
        "input": {
          "request": {
            "origin": "manual"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "genres": ["Sample Other Genre"],
            "exists_in_library_ids": [],
            "canonical_tag_keys": ["sample-key"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "request": {
            "origin": "manual"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "genres": ["Sample Other Genre"],
            "themes": ["sample-theme"],
            "exists_in_library_ids": []
          }
        },
        "expected": true
      },
      {
        "input": {
          "request": {
            "origin": "manual"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "themes": ["sample-theme"],
            "exists_in_library_ids": [],
            "canonical_tag_keys": ["sample-key"]
          }
        },
        "expected": false
      },
      {
        "input": {
          "request": {
            "origin": "manual"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "genres": ["Sample Genre"],
            "themes": ["sample-theme"],
            "exists_in_library_ids": [],
            "canonical_tag_keys": ["sample-key"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "request": {
            "origin": "public_list"
          },
          "library": {
            "facet": "anime"
          },
          "now": {
            "weekday": "monday"
          },
          "facts": {
            "genres": ["Sample Other Genre"],
            "themes": ["sample-theme"],
            "exists_in_library_ids": [],
            "canonical_tag_keys": ["sample-key"]
          }
        },
        "expected": true
      }
    ]
  },
  {
    "id": "manual-nullable-values",
    "scope": null,
    "model": {
      "version": 2,
      "family": "request",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.request.year",
          "operator": "GREATER_THAN",
          "value": "2020"
        },
        {
          "field": "input.request.year",
          "operator": "LESS_OR_EQUAL",
          "value": "2030"
        },
        {
