    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.request.title == \"Sample \\\"quoted\\\" \\\\ title\"\n\tinput.library.name != \"Ünïcødé 標籤 😀\"\n\tinput.library.is_default == true\n\tinput.now.hour_utc < 6\n}\n\napprove if rule_applies\n\ntags contains \"sample\" if rule_applies\n\nreasons contains \"reason with \\\"quotes\\\" and \\\\ slash\" if rule_applies\n"
  }
]
