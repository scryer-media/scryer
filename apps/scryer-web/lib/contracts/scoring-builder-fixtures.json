  {
    "id": "adjust-strings-and-lists",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.release.release_group",
          "operator": "EQUALS",
          "value": "SampleGroup"
        },
        {
          "field": "input.release.streaming_service",
          "operator": "NOT_EQUALS",
          "value": "sample-service"
        },
        {
          "field": "input.release.edition",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.release.protocol",
          "operator": "HAS_NO_VALUE",
          "value": ""
        },
        {
          "field": "input.context.media_type",
          "operator": "EQUALS",
          "value": "movie"
        },
        {
          "field": "input.profile.name",
          "operator": "NOT_EQUALS",
          "value": "Sample Profile"
        },
        {
          "field": "input.release.languages_audio",
          "operator": "CONTAINS",
          "value": "en"
        },
        {
          "field": "input.context.tags",
          "operator": "NOT_CONTAINS",
          "value": "sample-keep"
        },
        {
          "field": "input.release.languages_subtitles",
          "operator": "IS_EMPTY",
          "value": ""
        },
        {
          "field": "input.builtin_score.codes",
          "operator": "IS_NOT_EMPTY",
          "value": ""
        },
        {
          "field": "input.release.parse_confidence",
          "operator": "EQUALS",
          "value": "0.75"
        },
        {
          "field": "input.release.parse_confidence",
          "operator": "NOT_EQUALS",
          "value": "-1"
        },
        {
          "field": "input.context.coverage_member_count",
          "operator": "GREATER_THAN",
          "value": "1"
        },
        {
          "field": "input.release.anime_version",
          "operator": "LESS_THAN",
          "value": "3"
        },
        {
          "field": "input.release.revision",
          "operator": "GREATER_THAN",
          "value": "0"
        },
        {
          "field": "input.builtin_score.total",
          "operator": "LESS_THAN",
          "value": "1000"
        }
      ],
      "outputs": {
        "ADJUST_SCORE": {
          "code": "sample_penalty",
          "points": "-75"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.release.release_group == \"SampleGroup\"\n\tis_string(input.release.streaming_service)\n\tinput.release.streaming_service != \"sample-service\"\n\tinput.release.edition != null\n\tnot input.release.protocol != null\n\tinput.context.media_type == \"movie\"\n\tinput.profile.name != \"Sample Profile\"\n\t\"en\" in input.release.languages_audio\n\tis_array(input.context.tags)\n\tnot \"sample-keep\" in input.context.tags\n\tcount(input.release.languages_subtitles) == 0\n\tcount(input.builtin_score.codes) > 0\n\tinput.release.parse_confidence == 0.75\n\tinput.release.parse_confidence != -1\n\tis_number(input.context.coverage_member_count)\n\tinput.context.coverage_member_count > 1\n\tis_number(input.release.anime_version)\n\tinput.release.anime_version < 3\n\tinput.release.revision > 0\n\tinput.builtin_score.total < 1000\n}\n\nscore_entry[\"sample_penalty\"] := -75 if rule_applies\n",
    "cases": [
      {
        "input": {
          "release": {
            "release_group": "SampleGroup",
            "streaming_service": "sample-other-service",
            "edition": "Sample Edition",
            "protocol": null,
            "languages_audio": ["en"],
            "languages_subtitles": [],
            "parse_confidence": 0.75,
            "anime_version": 2,
            "revision": 1
          },
          "context": {
            "media_type": "movie",
            "tags": ["sample-other"],
            "coverage_member_count": 2
          },
          "profile": {
            "name": "Sample Other Profile"
          },
          "builtin_score": {
            "codes": ["sample_code"],
            "total": 999
          }
        },
        "expected": true
      },
      {
