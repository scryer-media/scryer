          "release": {
            "release_group": "SampleGroup",
            "streaming_service": "sample-other-service",
            "edition": "Sample Edition",
            "protocol": null,
            "languages_audio": ["en"],
            "languages_subtitles": [],
            "parse_confidence": 0.75,
            "anime_version": 2,
            "revision": 1
          },
          "context": {
            "media_type": "movie",
            "tags": ["sample-keep"],
            "coverage_member_count": 2
          },
          "profile": {
            "name": "Sample Other Profile"
          },
          "builtin_score": {
            "codes": ["sample_code"],
            "total": 999
          }
        },
        "expected": false
      },
