[
  {
    "id": "adjust-bools-and-numbers",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.release.is_remux",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.release.is_hardcoded_subs",
          "operator": "IS_FALSE",
          "value": ""
        },
        {
          "field": "input.release.revision",
          "operator": "GREATER_OR_EQUAL",
          "value": "2"
        },
        {
          "field": "input.builtin_score.total",
          "operator": "LESS_OR_EQUAL",
          "value": "500.5"
        },
        {
          "field": "input.context.has_existing_file",
          "operator": "IS_FALSE",
          "value": ""
        }
      ],
      "outputs": {
        "ADJUST_SCORE": {
          "code": "sample_remux_bonus",
          "points": "250"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.release.is_remux == true\n\tinput.release.is_hardcoded_subs == false\n\tinput.release.revision >= 2\n\tinput.builtin_score.total <= 500.5\n\tinput.context.has_existing_file == false\n}\n\nscore_entry[\"sample_remux_bonus\"] := 250 if rule_applies\n",
    "cases": [
      {
        "input": {
          "release": {
            "is_remux": true,
            "is_hardcoded_subs": false,
            "revision": 2
          },
          "builtin_score": {
            "total": 500.5
          },
          "context": {
            "has_existing_file": false
          }
        },
        "expected": true
      },
      {
        "input": {
          "release": {
            "is_remux": true,
            "is_hardcoded_subs": null,
            "revision": 2
          },
          "builtin_score": {
            "total": 500.5
          },
          "context": {
            "has_existing_file": false
          }
        },
        "expected": false
      },
      {
        "input": {
          "release": {
            "is_remux": true,
            "is_hardcoded_subs": false,
            "revision": 1
          },
          "builtin_score": {
            "total": 500.5
          },
          "context": {
            "has_existing_file": false
          }
        },
        "expected": false
      }
    ]
  },
  {
    "id": "block-any-nullable-values",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.release.size_bytes",
          "operator": "GREATER_THAN",
          "value": "100000000000"
        },
        {
          "field": "input.release.year",
          "operator": "LESS_THAN",
          "value": "1950"
        },
        {
          "field": "input.release.age_days",
          "operator": "NOT_EQUALS",
          "value": "0"
        },
        {
          "field": "input.file.video_height",
          "operator": "EQUALS",
          "value": "480"
        },
        {
          "field": "input.release.thumbs_down",
          "operator": "GREATER_OR_EQUAL",
          "value": "5"
        },
        {
          "field": "input.release.thumbs_up",
          "operator": "LESS_OR_EQUAL",
          "value": "1"
        },
        {
          "field": "input.context.existing_score",
          "operator": "HAS_VALUE",
          "value": ""
        },
        {
          "field": "input.file.duration_seconds",
          "operator": "HAS_NO_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "BLOCK": {
          "code": "sample_size_guard"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tis_number(input.release.size_bytes)\n\tinput.release.size_bytes > 100000000000\n}\n\nrule_applies if {\n\tis_number(input.release.year)\n\tinput.release.year < 1950\n}\n\nrule_applies if {\n\tis_number(input.release.age_days)\n\tinput.release.age_days != 0\n}\n\nrule_applies if {\n\tinput.file.video_height == 480\n}\n\nrule_applies if {\n\tis_number(input.release.thumbs_down)\n\tinput.release.thumbs_down >= 5\n}\n\nrule_applies if {\n\tis_number(input.release.thumbs_up)\n\tinput.release.thumbs_up <= 1\n}\n\nrule_applies if {\n\tinput.context.existing_score != null\n}\n\nrule_applies if {\n\tnot input.file.duration_seconds != null\n}\n\nscore_entry[\"sample_size_guard\"] := scryer.block_score() if rule_applies\n",
    "cases": [
      {
        "input": {
          "release": {
            "size_bytes": 1000000000,
            "year": 2000,
            "age_days": 0,
            "thumbs_down": 0,
            "thumbs_up": 10
          },
          "file": {
            "video_height": 1080,
            "duration_seconds": 3600
          },
          "context": {
            "existing_score": null
          }
        },
        "expected": false
      },
      {
