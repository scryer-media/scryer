  {
    "id": "escaping",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ANY",
      "conditions": [
        {
          "field": "input.release.raw_title",
          "operator": "EQUALS",
          "value": "Sample \"quoted\" \\ title"
        },
        {
          "field": "input.release.normalized_tokens",
          "operator": "CONTAINS",
          "value": "Ünïcødé 標籤 😀"
        }
      ],
      "outputs": {
        "BLOCK": {
          "code": "sample_escape_check"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.release.raw_title == \"Sample \\\"quoted\\\" \\\\ title\"\n}\n\nrule_applies if {\n\t\"Ünïcødé 標籤 😀\" in input.release.normalized_tokens\n}\n\nscore_entry[\"sample_escape_check\"] := scryer.block_score() if rule_applies\n",
    "cases": [
      {
        "input": {
          "release": {
            "raw_title": "Sample Other Title",
            "normalized_tokens": []
          }
        },
        "expected": false
      },
      {
        "input": {
          "release": {
            "raw_title": "Sample \"quoted\" \\ title",
            "normalized_tokens": []
          }
        },
        "expected": true
      },
      {
        "input": {
          "release": {
            "raw_title": "Sample Other Title",
            "normalized_tokens": ["Ünïcødé 標籤 😀"]
          }
        },
        "expected": true
      }
    ]
  },
  {
    "id": "extreme-points",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.profile.scoring_overrides.block_upscaled",
          "operator": "IS_TRUE",
          "value": ""
        },
        {
          "field": "input.release.stereoscopy.presentation",
          "operator": "EQUALS",
          "value": "full"
        },
        {
          "field": "input.release.stereoscopy.layout",
          "operator": "NOT_EQUALS",
          "value": "sample"
        },
        {
          "field": "input.release.stereoscopy.sampling",
          "operator": "HAS_VALUE",
          "value": ""
        }
      ],
      "outputs": {
        "ADJUST_SCORE": {
          "code": "sample_floor",
          "points": "-2147483648"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.profile.scoring_overrides.block_upscaled == true\n\tinput.release.stereoscopy.presentation == \"full\"\n\tis_string(input.release.stereoscopy.layout)\n\tinput.release.stereoscopy.layout != \"sample\"\n\tinput.release.stereoscopy.sampling != null\n}\n\nscore_entry[\"sample_floor\"] := -2147483648 if rule_applies\n",
    "cases": [
      {
        "input": {
          "profile": {
            "scoring_overrides": {
              "block_upscaled": true
            }
          },
          "release": {
            "stereoscopy": {
              "presentation": "full",
              "layout": "sample-other",
              "sampling": "half"
            }
          }
        },
        "expected": true
      },
      {
        "input": {
          "profile": {
            "scoring_overrides": {
              "block_upscaled": true
            }
          },
          "release": {
            "stereoscopy": {
              "presentation": "full",
              "layout": "sample-other",
              "sampling": null
            }
          }
        },
        "expected": false
      },
      {
        "input": {
          "profile": {
            "scoring_overrides": {
              "block_upscaled": true
            }
          },
          "release": {
            "stereoscopy": {
              "presentation": "full",
              "layout": "sample",
              "sampling": "half"
            }
          }
        },
        "expected": false
      }
    ]
  },
  {
    "id": "all-set-matches",
    "scope": null,
    "model": {
      "version": 2,
      "family": "scoring",
      "join": "ALL",
      "conditions": [
        {
          "field": "input.release.raw_title",
          "operator": "IS_ONE_OF",
          "value": "Sample\nExtra"
        },
        {
          "field": "input.release.edition",
          "operator": "IS_ONE_OF",
          "value": "Sample\nExtra"
        },
        {
          "field": "input.release.languages_audio",
          "operator": "CONTAINS_ANY",
          "value": "en\nExtra"
        }
      ],
      "outputs": {
        "ADJUST_SCORE": {
          "code": "sample_penalty",
          "points": "-75"
        }
      }
    },
    "source": "package rules\nimport rego.v1\n\nrule_applies if {\n\tinput.release.raw_title in {\"Sample\", \"Extra\"}\n\tinput.release.edition in {\"Sample\", \"Extra\"}\n\tcount([item | some item in input.release.languages_audio; item in {\"en\", \"Extra\"}]) > 0\n}\n\nscore_entry[\"sample_penalty\"] := -75 if rule_applies\n",
    "cases": [
      {
        "input": {
          "release": {
            "raw_title": "Sample",
            "edition": "Sample",
            "languages_audio": ["en"]
          }
        },
        "expected": true
      },
      {
        "input": {
          "release": {
            "raw_title": "Elsewhere",
            "edition": "Sample",
            "languages_audio": ["en"]
          }
        },
        "expected": false
      },
      {
        "input": {
          "release": {
            "raw_title": "Sample",
            "edition": "Elsewhere",
            "languages_audio": ["en"]
          }
        },
        "expected": false
      },
      {
        "input": {
          "release": {
            "raw_title": "Sample",
            "edition": "Sample",
            "languages_audio": ["Elsewhere"]
          }
        },
        "expected": false
      }
    ]
  },
