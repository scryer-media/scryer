{
  "name": "scryer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/report-build-chunks.mjs",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "npm run typecheck && eslint 'src/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}'",
    "check:react-compiler": "node scripts/check-react-compiler.mjs",
    "test": "node --test \"lib/**/*.test.ts\"",
    "test:graphql-compat": "node --test scripts/check-graphql-schema-compat.test.mjs"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fullcalendar/react": "^7.0.2",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@urql/core": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.4",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "immutable": "5.1.9"
  }
}
