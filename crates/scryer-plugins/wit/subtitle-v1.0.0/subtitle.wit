package scryer:subtitle@1.0.0;

/// The subtitle-provider contract.
///
/// Both payloads are UTF-8 JSON, matching the indexer and archive worlds:
/// `describe` returns a `PluginDescriptor` document, and `process` exchanges a
/// `scryer_plugin_sdk::command::PluginCommandRequest` for a
/// `PluginCommandResponse` — the *same* envelope the wasip1 command ABI already
/// carries on stdin/stdout, carrying `PluginCommand::Subtitle` and its
/// `validate-config` / `search` / `download` / `generate` operations. A guest
/// migrating from the command ABI keeps its request and response types and its
/// dispatch `match`; only the transport changes. Keeping the payload an opaque
/// byte string is what lets the SDK add subtitle operations without a WIT
/// revision.
///
/// Host services arrive through the shared `scryer:host/services@1.0.0` import
/// rather than a subtitle-specific interface, so config, plugin state, HTTP,
/// and host-owned archive extraction reach a subtitle provider by exactly the
/// bytes the core-module ABI uses. See that package for the encoding and for
/// why capability availability is expressed in-band.
///
/// WASI Preview 2 is imported implicitly: the host links the full p2 surface
/// (`wasmtime_wasi::p2::add_to_linker_async`), so a guest sees clocks, random,
/// and its captured stdio through `wasi:*` without those imports appearing in
/// this world. Subtitle providers receive no filesystem preopens for catalog
/// operations; a generator invocation is preopened its read-only input root
/// exactly as the legacy runtime preopened it.
world subtitle-provider {
  import scryer:host/services@1.0.0;

  enum invocation-error {
    failed,
    cancelled,
    invalid-response,
  }

  export describe: func() -> list<u8>;
  export process: func(request: list<u8>) -> result<list<u8>, invocation-error>;
}
