{
  "id": "newznab",
  "name": "Newznab Indexer",
  "provider": {
    "capabilities": {
      "anidb_search": false,
      "category_model": {
        "provider_category_metadata": true,
        "separate_anime_categories": true,
        "value_kinds": [
          "numeric"
        ]
      },
      "deduplicates_aliases": false,
      "episode_param": "ep",
      "feed_modes": [
        "recent",
        "rss",
        "automatic_search",
        "interactive_search"
      ],
      "imdb_search": true,
      "limits": {
        "api_quota_supported": true,
        "grab_quota_supported": true,
        "max_page_size": 100,
        "max_pages": 30,
        "page_size": 100
      },
      "protocols": [
        "usenet"
      ],
      "query_param": "q",
      "response_features": {
        "comments": true,
        "grabs": true,
        "guid": true,
        "info_url": true,
        "languages": true,
        "password_hint": true,
        "protection_hint": true,
        "raw_provider_metadata": true,
        "subtitles": false,
        "votes": false
      },
      "rss": true,
      "search": true,
      "search_inputs": [
        "title_query",
        "id_query",
        "season",
        "episode",
        "category",
        "limit"
      ],
      "season_param": "season",
      "supported_external_ids": [
        "imdb_id",
        "tvdb_id",
        "tmdb_id",
        "tvmaze_id",
        "tvrage_id"
      ],
      "supported_ids": {
        "anime": [
          "tvdb_id"
        ],
        "movie": [
          "imdb_id"
        ],
        "series": [
          "tvdb_id"
        ]
      },
      "tvdb_search": true
    },
    "config_fields": [
      {
        "field_type": "string",
        "help_text": "Indexer site URL, for example https://indexer.example",
        "key": "base_url",
        "label": "Base URL",
        "required": true,
        "role": "connection_url",
        "value_source": "user"
      },
      {
        "field_type": "password",
        "help_text": "Indexer API key",
        "key": "api_key",
        "label": "API Key",
        "required": false,
        "value_source": "user"
      },
      {
        "default_value": "/api",
        "field_type": "string",
        "help_text": "API endpoint path (e.g. /api, /api/v1/api, /nabapi)",
        "key": "api_path",
        "label": "API Path",
        "required": false,
        "value_source": "user"
      },
      {
        "field_type": "string",
        "help_text": "Extra query parameters appended to every request (e.g. &dl=1&attrs=poster)",
        "key": "additional_params",
        "label": "Additional Parameters",
        "required": false,
        "value_source": "user"
      }
    ],
    "kind": "indexer",
    "provider_type": "newznab",
    "source_kind": "usenet"
  },
  "sdk_constraint": ">=3.7.0, <4.0.0",
  "sdk_version": "3.7.0",
  "version": "0.2.22"
}
