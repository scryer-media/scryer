# ─── Network ──────────────────────────────────────────────────────────
# Address and port to bind the HTTP server.
# SCRYER_BIND=127.0.0.1:8080
# Authless browser access on a non-loopback bind is deprecated and will be
# disabled in a future release. Bind Scryer to loopback and place any reverse
# proxy in front of it, or enable authentication.

# Optional reverse-proxy path prefix. Use "/" for root hosting or a value like "/scryer".
# SCRYER_BASE_PATH=/

# Comma-separated IP addresses or CIDRs for reverse proxies whose
# X-Forwarded-For chains may identify rate-limit clients. No proxies are
# trusted by default. Configure only controlled proxy addresses; for Docker,
# prefer a dedicated narrow network rather than a shared container subnet.
# SCRYER_RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1,::1,172.20.0.0/24

# Comma-separated list of allowed CORS origins. Dev builds only — release builds
# log a warning and ignore any value set here. There is no wildcard: "*" is not
# honored. Release builds allow no cross-origin requests.
# SCRYER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ─────────────────────────────────────────────────────────
# SQLite database path. Use a file path for persistence or in-memory for dev.
# SCRYER_DB_PATH=sqlite:///data/scryer.db

# Migration mode: "apply" (default), "auto", or "1" to apply migrations;
# "validate" or "0" to check for pending migrations and exit without serving.
# Any unrecognized value logs a warning and applies migrations anyway.
# SCRYER_DB_MIGRATION_MODE=apply

# ─── Authentication ───────────────────────────────────────────────────
# There are no default credentials. A fresh install creates a built-in "admin"
# account with no password and leaves form login disabled, so nothing prompts
# for a sign-in until you enable it.
#
# Set an admin password in Settings > Users before turning form login on.
# Scryer refuses to enable it while no administrator has a usable password, or
# while the password is still the legacy bootstrap value "admin" — that check
# is enforced both at startup and when saving the setting.
#
# If you lock yourself out, start once with SCRYER_RECOVERY_ADMIN_PASSWORD set.

# Force form login on or off, overriding the saved database setting.
# SCRYER_AUTH_ENABLED=true

# JWT issuer claim.
# SCRYER_JWT_ISSUER=scryer

# JWT access token TTL in seconds (default: 86400 = 24 hours).
# SCRYER_JWT_ACCESS_TTL_SECONDS=86400

# Debug/test builds only: seed managed API keys for local integration work. Each
# semicolon-separated declaration is username|label|raw_key|expires_at, where
# expires_at is "never" or an RFC 3339 UTC timestamp. Declarations removed from
# this variable are revoked at the next debug/test startup. Release binaries do
# not read this variable.
# SCRYER_DEV_API_KEYS=admin|local-agent|ska_<22-char-lookup>.<43-char-secret>|never

# ─── Encryption ───────────────────────────────────────────────────────
# Base64-encoded 32-byte master key for encrypting sensitive data at rest.
# Generate one with `scryer --generate-key`. Takes precedence over everything else.
# If unset, Scryer uses a platform keystore (Docker secret, OS keychain, or key
# file) and generates a key there on first run.
# SCRYER_ENCRYPTION_KEY=

# ─── Metadata Gateway ────────────────────────────────────────────────
# GraphQL endpoint for the metadata gateway service. Official builds have this
# compiled in, so it only needs setting when pointing at a different gateway.
# SCRYER_METADATA_GATEWAY_GRAPHQL_URL=http://127.0.0.1:8090/graphql

# ─── Media Paths ─────────────────────────────────────────────────────
# Root directories for media library storage. These seed the settings on startup
# and stop taking effect once the path is changed in the UI.
# SCRYER_MOVIES_PATH=/media/movies
# SCRYER_SERIES_PATH=/media/series
# SCRYER_ANIME_PATH=/media/anime

# ─── TLS ──────────────────────────────────────────────────────────────
# Paths to PEM-encoded TLS certificate and private key.
# Both must be set to enable TLS; otherwise the server runs plain HTTP.
# SCRYER_TLS_CERT=
# SCRYER_TLS_KEY=

# ─── Background Tasks ────────────────────────────────────────────────
# Enable or disable the background acquisition poller (default: true).
# Only "false", "0", "no", or "off" disable it; any other value enables it.
# SCRYER_BACKGROUND_ACQUISITION=true

# ─── Web UI ───────────────────────────────────────────────────────────
# Override the embedded web UI with a local build directory. Release builds only;
# ignored entirely in debug builds. The embedded UI is the default.
# SCRYER_WEB_DIST_DIR=

# URL of the web UI (used for fallback page links). Dev builds only.
# SCRYER_WEB_UI_URL=http://127.0.0.1:3000

# ─── Development ──────────────────────────────────────────────────────
# Enables development-only authless overrides. It is rejected by release builds.
# SCRYER_DEVELOPMENT_MODE=true

# Requires SCRYER_DEVELOPMENT_MODE=true. Deprecated: use SCRYER_AUTH_ENABLED=false
# for loopback-only authless access instead.
# SCRYER_DEV_AUTO_LOGIN=false

# ─── Logging ──────────────────────────────────────────────────────────
# Standard Rust tracing filter (e.g., "info", "scryer=debug").
# RUST_LOG=info
